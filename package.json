{
  "name": "spotlight-tour",
  "version": "0.4.1",
  "description": "Cinematic onboarding tour: page zoom-out, flying spotlight clone, smooth step navigation",
  "keywords": [
    "onboarding",
    "tour",
    "spotlight",
    "product-tour",
    "walkthrough",
    "ui-tour",
    "tutorial",
    "intro",
    "guide",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "demo": "npx serve . -l 3000 --no-clipboard",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0"
  },
  "unpkg": "dist/index.umd.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarureno/spotlight-tour-js.git"
  }
}
